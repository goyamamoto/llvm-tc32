; The indirect call goes through a local "bx r2" (bl .Ltmp0 above), not blx:
; RUN: llc -mtriple=thumbv4t-none-eabi -mattr=+noarm < %s | not grep blx
; RUN: llc -mtriple=thumbv4t-none-eabi -mattr=+noarm < %s | grep -A1 '^.Ltmp0:' | grep 'bx.r2'

